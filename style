*{box-sizing:border-box}body{margin:0;background:#f4f6fb;color:#172033;font-family:Tahoma,Arial,sans-serif}header{position:sticky;top:0;background:#17243a;color:#fff;padding:16px 5%;display:flex;justify-content:space-between}#timer{font-size:24px;direction:ltr}main{max-width:1150px;margin:28px auto;padding:0 16px}.card{background:#fff;border-radius:16px;padding:24px;box-shadow:0 7px 28px #0001;margin-bottom:18px}input{display:block;width:100%;max-width:500px;margin:10px 0;padding:12px;border:1px solid #d5dbe5;border-radius:9px;font-size:15px}button{border:0;border-radius:9px;padding:11px 18px;cursor:pointer;margin:4px;background:#2563eb;color:#fff}.danger{background:#dc2626;width:100%}.hidden{display:none}.layout{display:grid;grid-template-columns:220px 1fr;gap:18px}.layout aside{height:max-content;position:sticky;top:75px}.nav{display:grid;grid-template-columns:repeat(4,1fr);gap:5px}.nav button{background:#e9edf4;color:#111;padding:8px;margin:0}.nav .cur{outline:3px solid #2563eb}.nav .ans{background:#bbf7d0}.q{font-size:19px;line-height:2;white-space:pre-wrap}.option{display:block;border:1px solid #dce1e9;border-radius:11px;padding:12px;margin:9px 0;cursor:pointer;line-height:1.8}.selected{background:#eff6ff;border-color:#2563eb}.option input{display:inline;width:auto;margin-left:8px}.actions{display:flex;justify-content:space-between;margin-top:22px}@media(max-width:800px){.layout{grid-template-columns:1fr}.layout aside{position:static}.nav{grid-template-columns:repeat(8,1fr)}}
